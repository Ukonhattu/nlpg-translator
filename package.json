{
  "name": "nlp-translator-ts",
  "version": "0.1.0",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "nlp2py": "bin/nlp2py.mjs"
  },
  "scripts": {
    "build": "node scripts/gen-version.mjs && tsc",
    "start": "node dist/server.js",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "prepare": "npm run build",
    "prestart": "npm run build",
    "pretest": "npm run build"
  },
  "dependencies": {
    "express": "^4.19.0",
    "tree-sitter-python": "^0.25.0",
    "web-tree-sitter": "^0.27.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.20.5",
    "@types/supertest": "^7.2.1",
    "ajv": "^8.20.0",
    "eslint": "^9.17.0",
    "fast-check": "^4.10.2",
    "supertest": "^7.3.2",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.18.0",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=22"
  }
}
